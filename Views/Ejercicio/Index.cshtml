@model IEnumerable<stoiko3.Models.Ejercicio>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NomEjercicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoEjercicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PuntosEjercicio)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NomEjercicio)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.TipoEjercicio)
            </td>
            <td>
                @Html.DisplayFor(model => item.PuntosEjercicio)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdEjercicio">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdEjercicio">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdEjercicio">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
