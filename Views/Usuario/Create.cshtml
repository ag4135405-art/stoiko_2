@model stoiko3.Models.Usuario

@{
    ViewData["Title"] = "STOIKO - Crear Cuenta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-dark: #0b0d10;
            --bg-card: #14171d;
            --bg-input: #1c2029;
            --bg-card-hover: #1c2029;
            --orange-primary: #FF5500;
            --orange-hover: #E04B00;
            --orange-glow: rgba(255, 85, 0, 0.25);
            --text-main: #FFFFFF;
            --text-muted: #94A3B8;
            --border-color: #222732;
            --error-color: #FF4D4D;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
        }

        /* CONTENEDOR A PANTALLA COMPLETA (100VW x 100VH) */
        .fullscreen-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100vw;
            height: 100vh;
        }

        /* LADO IZQUIERDO: MITAD VACÍA PARA DISEÑO */
        .design-slot {
            background-color: var(--bg-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem;
            position: relative;
        }

        .design-placeholder {
            border: 2px dashed rgba(255, 85, 0, 0.25);
            border-radius: 20px;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            text-align: center;
            padding: 2rem;
        }

        .design-placeholder i {
            font-size: 3rem;
            color: var(--orange-primary);
            margin-bottom: 1rem;
            opacity: 0.6;
        }

        .design-placeholder p {
            font-size: 0.95rem;
            max-width: 280px;
            line-height: 1.5;
        }

        /* LADO DERECHO: FORMULARIO DE REGISTRO */
        .form-section {
            background-color: var(--bg-card);
            border-left: 1px solid var(--border-color);
            padding: 4rem 4rem 3rem 4rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        /* CONTENEDOR DE NAVEGACIÓN SUPERIOR CON MÁS ESPACIO ENTRE BOTONES */
        .top-navigation-links {
            position: absolute;
            top: 2.5rem;
            left: 4rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 1.5rem; /* Espacio entre cada botón */
        }

        /* ESTILO BOTÓN NARANJA PRINCIPAL / OUTLINE */
        .btn-stoiko-primary {
            background-color: var(--orange-primary);
            color: #FFFFFF !important;
            padding: 0.65rem 1.6rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            box-shadow: 0 4px 15px var(--orange-glow);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-stoiko-primary:hover {
            background-color: var(--orange-hover);
            transform: translateY(-2px);
        }

        .btn-stoiko-outline {
            color: var(--text-main) !important;
            border: 1.5px solid var(--border-color);
            padding: 0.6rem 1.4rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-stoiko-outline:hover {
            border-color: var(--orange-primary);
            color: var(--orange-primary) !important;
        }

        .brand-header {
            text-align: center;
            margin-bottom: 2.2rem;
        }

        .brand-logo {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.2rem;
            font-weight: 900;
            letter-spacing: 8px;
            color: var(--orange-primary);
            text-transform: uppercase;
            text-shadow: 0 0 20px var(--orange-glow);
            text-decoration: none;
            display: inline-block;
        }

        .brand-subtitle {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-top: 0.4rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 1.2rem;
            color: var(--text-muted);
            font-size: 1.1rem;
            pointer-events: none;
            transition: color 0.3s ease;
        }

        .form-control {
            width: 100%;
            background-color: var(--bg-input);
            border: 1.5px solid var(--border-color);
            border-radius: 10px;
            padding: 0.9rem 1.2rem 0.9rem 3rem;
            color: var(--text-main);
            font-size: 0.95rem;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--orange-primary);
            box-shadow: 0 0 12px var(--orange-glow);
        }

        .form-control:focus + .input-icon {
            color: var(--orange-primary);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--orange-primary);
            color: #FFFFFF;
            border: none;
            padding: 1rem;
            border-radius: 10px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            box-shadow: 0 6px 20px var(--orange-glow);
            transition: all 0.3s ease;
            margin-top: 0.8rem;
        }

        .btn-submit:hover {
            background-color: var(--orange-hover);
            transform: translateY(-2px);
        }

        /* SEPARADOR Y BOTÓN DE GOOGLE */
        .divider {
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 1.5rem 0 0.5rem 0;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-google {
            width: 100%;
            background-color: var(--bg-input);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 0.9rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            text-decoration: none;
            transition: all 0.3s ease;
            margin-top: 0.8rem;
        }

        .btn-google:hover {
            border-color: var(--orange-primary);
            background-color: var(--bg-card-hover);
            color: var(--text-main);
        }

        .card-footer-text {
            text-align: center;
            margin-top: 1.8rem;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .card-footer-text a {
            color: var(--orange-primary);
            font-weight: 700;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .card-footer-text a:hover {
            text-decoration: underline;
        }

        .text-danger {
            color: var(--error-color);
            font-size: 0.85rem;
            margin-bottom: 1rem;
        }

        /* DISEÑO RESPONSIVO PARA PANTALLAS PEQUEÑAS */
        @@media (max-width: 900px) {
            html, body {
                overflow: auto;
            }
            .fullscreen-split {
                grid-template-columns: 1fr;
                height: auto;
                min-height: 100vh;
            }
            .design-slot {
                display: none;
            }
            .form-section {
                padding: 6rem 2rem 3rem 2rem;
                border-left: none;
            }
            .top-navigation-links {
                top: 2rem;
                left: 2rem;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.8rem;
            }
        }
    </style>
</head>
<body>

    <div class="fullscreen-split">

        <!-- LADO IZQUIERDO: MITAD VACÍA PARA DISEÑO -->
        <div class="design-slot">
            <div class="design-placeholder">
                <i class="bi bi-palette-fill"></i>
                <p>Espacio reservado para tu diseño o ilustración</p>
            </div>
        </div>

        <!-- LADO DERECHO: FORMULARIO DE REGISTRO -->
        <div class="form-section">
            
            <!-- BOTONES SUPERIORES CON NUEVO ESTILO Y MÁS ESPACIO -->
            <div class="top-navigation-links">
                <a asp-controller="Home" asp-action="bienvenida" class="btn-stoiko-outline">
                    <i class="bi bi-arrow-left"></i> Volver a STOIKO
                </a>
                <a asp-controller="Home" asp-action="iniciar_ses" class="btn-stoiko-primary">
                    Iniciar sesión
                </a>
            </div>

            <div class="brand-header">
                <a asp-controller="Home" asp-action="Index" class="brand-logo">STOIKO</a>
                <p class="brand-subtitle">Crea tu cuenta y empieza tu disciplina</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <form asp-action="Create" method="post">

                <!-- Campo Correo (EmailUsu) -->
                <div class="form-group">
                    <label asp-for="EmailUsu" class="form-label">Correo Electrónico</label>
                    <div class="input-wrapper">
                        <input asp-for="EmailUsu" type="email" class="form-control" placeholder="ejemplo@stoiko.com" required />
                        <i class="bi bi-envelope-fill input-icon"></i>
                    </div>
                </div>

                <!-- Campo Contraseña (PasswordUsu) -->
                <div class="form-group">
                    <label asp-for="PasswordUsu" class="form-label">Contraseña</label>
                    <div class="input-wrapper">
                        <input asp-for="PasswordUsu" type="password" class="form-control" placeholder="••••••••" required />
                        <i class="bi bi-lock-fill input-icon"></i>
                    </div>
                </div>

                <!-- Botón de Envío -->
                <button type="submit" class="btn-submit">Registrarme</button>

            </form>

            <div class="divider">— o —</div>

            <!-- BOTÓN DE REGISTRO / INICIO RÁPIDO CON GOOGLE -->
            <a href="/Usuario/LoginGoogle" class="btn-google">
                <svg width="22" height="22" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M17.64 9.2c0-.74-.06-1.28-.19-1.84H9v3.34h4.96c-.1.83-.64 2.08-1.84 2.92l2.84 2.2c1.7-1.57 2.68-3.88 2.68-6.62z" />
                    <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.84-2.2c-.76.53-1.78.9-3.12.9-2.38 0-4.41-1.57-5.13-3.74L.97 13.04C2.45 15.98 5.48 18 9 18z" />
                    <path fill="#FBBC05" d="M3.87 10.78c-.19-.58-.3-1.18-.3-1.78s.11-1.2.3-1.78L.97 4.96C.35 6.18 0 7.55 0 9s.35 2.82.97 4.04l2.9-2.26z" />
                    <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.46 3.44 1.34l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.45 2.02.97 4.96l2.9 2.26C4.59 5.05 6.62 3.58 9 3.58z" />
                </svg>
                Registrarse con Google
            </a>

            <div class="card-footer-text">
                ¿Ya tienes una cuenta? <a asp-controller="Home" asp-action="iniciar_ses">Inicia sesión aquí</a>
            </div>

        </div>

    </div>

</body>
</html>